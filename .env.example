# ============================================================
# LukMailer Configuration Template (.env.example)
# Copy or rename this file to '.env' and fill in your details.
# Your actual '.env' file is protected and ignored by git.
# ============================================================

# 1. Candidate Information
CANDIDATE_NAME=Your Full Name
TARGET_ROLE=Full Stack Developer

# 2. Sender Email & App Password
# For Gmail: Use your full Gmail address and a 16-character Google App Password (not your normal password)
# App Password setup: https://myaccount.google.com/apppasswords
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_16_character_app_password

# 3. Groq API Key
# Generated from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_actual_api_key_here

# 4. Automation & Preview Preferences
# Set SEND_TEST_PREVIEW to true to send a sample to your inbox first, or false to skip preview
SEND_TEST_PREVIEW=false

# Set AUTO_CONFIRM to true to automatically start emailing without pausing for interactive confirmation
AUTO_CONFIRM=true

# (Optional) Specific file names inside input/ and attachments/
# CONTACTS_FILE=sample_recruiters.csv
# RESUME_FILE=resume.pdf
